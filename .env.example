# Обязательно укажите свой контакт в User-Agent (требование hh.ru).
# Формат: ИмяПриложения/версия (ваш_реальный@email)
# Иначе возможны bad_user_agent / 403 и подстановка демо-данных.
# HH_USER_AGENT=MyTeam-ResumePredictor/1.0 (you@gmail.com)
HH_USER_AGENT=ResumeMarketValue/1.0 (hackathon@tbank.local)
USE_MOCK_ON_HH_FAILURE=true

# Порт FastAPI для dev. Если 8000 занят или Windows WinError 10013 — смените, например на 8787.
# Скопируйте этот файл в .env в корне репозитория; Vite читает BACKEND_PORT оттуда для прокси.
# BACKEND_PORT=8787
